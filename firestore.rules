rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Secure nested user documents and subcollections
    match /users/{userId} {
      allow read, write: if true; // Temporarily allow for dev testing when Clerk JWT template is missing
      
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
